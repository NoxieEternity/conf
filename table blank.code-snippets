  "ConfPortal Profile Template": {
    "prefix": "profile",
    "scope": "html, jinja, jinja-html, django-html",
    "body": [
      "{% extends \"base.html\" %}",
      "{% block title %}Профиль{% endblock %}",
      "{% block content %}",
      "<div class=\"card\">",
      "  <h1>Мой профиль</h1>",
      "  <div id=\"profile-content\">",
      "    {% if user %}",
      "      <p><strong>Логин:</strong> {{ user.login }}</p>",
      "      <p><strong>ФИО:</strong> {{ user.fullname }}</p>",
      "      <p><strong>Телефон:</strong> {{ user.phone }}</p>",
      "      <p><strong>E-mail:</strong> {{ user.email }}</p>",
      "    {% else %}",
      "      <p class=\"muted\">Администратор системы</p>",
      "    {% endif %}",
      "  </div>",
      "</div>",
      "{% endblock %}"
    ],
    "description": "Шаблон profile.html для ConfPortal: карточка профиля пользователя с логином, ФИО, телефоном и email"
  },

  "ConfPortal Admin Template": {
    "prefix": "confportal-admin",
    "scope": "html, jinja, jinja-html, django-html",
    "body": [
      "{% extends \"base.html\" %}",
      "{% block title %}Админ-панель{% endblock %}",
      "{% block content %}",
      "<div class=\"card\">",
      "  <h1>Панель администратора</h1>",
      "  <div id=\"list\">",
      "    {% if requests|length == 0 %}",
      "      <p class=\"muted\">Заявок пока нет</p>",
      "    {% else %}",
      "      <table>",
      "        <thead><tr>",
      "          <th>ID</th><th>Пользователь</th><th>Помещение</th><th>Дата</th>",
      "          <th>Оплата</th><th>Статус</th><th>Отзыв</th><th>Действия</th>",
      "        </tr></thead>",
      "        <tbody>",
      "          {% for r in requests %}",
      "          <tr>",
      "            <td>{{ r.id }}</td>",
      "            <td>{{ r.user_login }}</td>",
      "            <td>{{ r.room }}</td>",
      "            <td>{{ r.date }}</td>",
      "            <td>{{ r.payment }}</td>",
      "            <td>",
      "              {% if r.status == 'Новая' %}<span class=\"status new\">{{ r.status }}</span>",
      "              {% elif r.status == 'Мероприятие назначено' %}<span class=\"status scheduled\">{{ r.status }}</span>",
      "              {% else %}<span class=\"status done\">{{ r.status }}</span>{% endif %}",
      "            </td>",
      "            <td>{{ r.feedback or '—' }}</td>",
      "            <td>",
      "              {% if r.status == 'Новая' %}",
      "                <form method=\"post\" action=\"{{ url_for('set_status', req_id=r.id, status='Мероприятие назначено') }}\" style=\"display:inline\">",
      "                  <button type=\"submit\">Назначить</button>",
      "                </form>",
      "                <form method=\"post\" action=\"{{ url_for('set_status', req_id=r.id, status='Завершено') }}\" style=\"display:inline\">",
      "                  <button type=\"submit\" class=\"danger\">Завершить</button>",
      "                </form>",
      "              {% else %}—{% endif %}",
      "            </td>",
      "          </tr>",
      "          {% endfor %}",
      "        </tbody>",
      "      </table>",
      "    {% endif %}",
      "  </div>",
      "</div>",
      "{% endblock %}"
    ],
    "description": "Шаблон admin.html для ConfPortal: таблица всех заявок со статусами, отзывами и кнопками Назначить/Завершить"
  },
  
  "ConfPortal Index Template": {
    "prefix": "confportal-index",
    "scope": "html, jinja, jinja-html, django-html",
    "body": [
      "{% extends \"base.html\" %}",
      "{% block title %}ConfPortal — Конференции 2027{% endblock %}",
      "{% block content %}",
      "<section class=\"hero\">",
      "  <h1>Конференции и деловые мероприятия 2027</h1>",
      "  <p>Организуйте конференции в комфортных помещениях. Быстрая подача заявки, прозрачный статус, удобная оплата — очно или через СБП.</p>",
      "  <a href=\"{{ url_for('register') }}\" class=\"btn\" style=\"margin-top:20px;background:#fff;color:var(--blue-900)\">Начать</a>",
      "</section>",
      "",
      "<h2>Наши площадки</h2>",
      "<div class=\"gallery\">",
      "  {% for img in images %}",
      "    <img src=\"{{ url_for('static', filename='images/' ~ img) }}\" alt=\"Площадка\">",
      "  {% endfor %}",
      "</div>",
      "{% endblock %}",
      "{% block footer %}<footer>© 2027 ConfPortal</footer>{% endblock %}"
    ],
    "description": "Шаблон index.html для ConfPortal: hero-секция и динамическая галерея площадок из списка images (static/images/)"
  }


}