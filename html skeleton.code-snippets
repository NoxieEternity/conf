  "ConfPortal Base Template": {
    "prefix": "base",
    "scope": "html, jinja, jinja-html, django-html",
    "body": [
      "<!DOCTYPE html>",
      "<html lang=\"ru\">",
      "<head>",
      "  <meta charset=\"UTF-8\">",
      "  <title>{% block title %}ConfPortal{% endblock %}</title>",
      "  <link rel=\"stylesheet\" href=\"{{ url_for('static', filename='styles.css') }}\">",
      "</head>",
      "<body>",
      "  <header>",
      "    <a href=\"{{ url_for('index') }}\" class=\"logo\">ConfPortal</a>",
      "    <nav id=\"nav\">",
      "      {% if current %}",
      "        <a href=\"{{ url_for('index') }}\">Главная</a>",
      "        <a href=\"{{ url_for('profile') }}\">Профиль</a>",
      "        <a href=\"{{ url_for('new_request') }}\">Новая заявка</a>",
      "        <a href=\"{{ url_for('my_requests') }}\">Мои заявки</a>",
      "        {% if is_admin %}<a href=\"{{ url_for('admin') }}\">Админ-панель</a>{% endif %}",
      "        <a href=\"{{ url_for('logout') }}\">Выйти</a>",
      "      {% else %}",
      "        <a href=\"{{ url_for('index') }}\">Главная</a>",
      "        <a href=\"{{ url_for('login') }}\">Войти</a>",
      "        <a href=\"{{ url_for('register') }}\">Регистрация</a>",
      "      {% endif %}",
      "    </nav>",
      "  </header>",
      "  <main>",
      "    {% block content %}{% endblock %}",
      "  </main>",
      "  {% block footer %}{% endblock %}",
      "</body>",
      "</html>"
    ],
    "description": "Базовый шаблон base.html для ConfPortal: каркас с шапкой, навигацией по ролям (гость/пользователь/админ), блоком контента и футера"
  },
  
  "ConfPortal Styles": {
    "prefix": "css",
    "scope": "css",
    "body": [
      "* { box-sizing: border-box; margin: 0; padding: 0; }",
      "",
      ":root {",
      "  --blue-900: #0b3d91;",
      "  --blue-700: #1558d6;",
      "  --blue-500: #3b7ddd;",
      "  --blue-100: #e8f0fe;",
      "  --bg: #ffffff;",
      "  --text: #1a1a1a;",
      "  --muted: #6b7280;",
      "  --border: #d7e3f4;",
      "  --danger: #c0392b;",
      "  --success: #1e88e5;",
      "}",
      "",
      "body {",
      "  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;",
      "  background: #f6f9ff;",
      "  color: var(--text);",
      "  min-height: 100vh;",
      "  display: flex;",
      "  flex-direction: column;",
      "}",
      "",
      "header {",
      "  background: #fff;",
      "  border-bottom: 1px solid var(--border);",
      "  padding: 14px 24px;",
      "  display: flex;",
      "  align-items: center;",
      "  justify-content: space-between;",
      "}",
      "",
      "header .logo {",
      "  font-weight: 700;",
      "  color: var(--blue-900);",
      "  font-size: 20px;",
      "  text-decoration: none;",
      "}",
      "",
      "header nav a {",
      "  margin-left: 18px;",
      "  color: var(--blue-700);",
      "  text-decoration: none;",
      "  font-size: 14px;",
      "}",
      "",
      "header nav a:hover { text-decoration: underline; }",
      "",
      "main {",
      "  flex: 1;",
      "  padding: 32px 24px;",
      "  max-width: 1100px;",
      "  width: 100%;",
      "  margin: 0 auto;",
      "}",
      "",
      "h1 { color: var(--blue-900); margin-bottom: 18px; font-size: 26px; }",
      "h2 { color: var(--blue-900); margin-bottom: 12px; font-size: 20px; }",
      "p.muted { color: var(--muted); margin-bottom: 16px; }",
      "",
      ".card {",
      "  background: #fff;",
      "  border: 1px solid var(--border);",
      "  border-radius: 10px;",
      "  padding: 24px;",
      "  margin-bottom: 20px;",
      "  box-shadow: 0 1px 3px rgba(11, 61, 145, 0.04);",
      "}",
      "",
      "form .field { margin-bottom: 14px; }",
      "form label {",
      "  display: block;",
      "  font-size: 13px;",
      "  color: var(--blue-900);",
      "  margin-bottom: 6px;",
      "  font-weight: 600;",
      "}",
      "form input, form select, form textarea {",
      "  width: 100%;",
      "  padding: 10px 12px;",
      "  border: 1px solid var(--border);",
      "  border-radius: 6px;",
      "  font-size: 14px;",
      "  background: #fff;",
      "  transition: border-color .15s;",
      "}",
      "form input:focus, form select:focus, form textarea:focus {",
      "  outline: none;",
      "  border-color: var(--blue-500);",
      "  box-shadow: 0 0 0 3px rgba(59, 125, 221, 0.15);",
      "}",
      "",
      "button, .btn {",
      "  background: var(--blue-700);",
      "  color: #fff;",
      "  border: none;",
      "  padding: 10px 18px;",
      "  border-radius: 6px;",
      "  font-size: 14px;",
      "  cursor: pointer;",
      "  text-decoration: none;",
      "  display: inline-block;",
      "  transition: background .15s;",
      "}",
      "button:hover, .btn:hover { background: var(--blue-900); }",
      "button.secondary { background: #fff; color: var(--blue-700); border: 1px solid var(--blue-700); }",
      "button.secondary:hover { background: var(--blue-100); }",
      "button.danger { background: var(--danger); }",
      "",
      ".message {",
      "  padding: 10px 14px;",
      "  border-radius: 6px;",
      "  margin-bottom: 14px;",
      "  font-size: 14px;",
      "}",
      ".message.error { background: #fdecea; color: var(--danger); border: 1px solid #f5c6cb; }",
      ".message.success { background: #e8f0fe; color: var(--blue-900); border: 1px solid var(--border); }",
      "",
      ".link {",
      "  display: inline-block;",
      "  margin-top: 10px;",
      "  color: var(--blue-700);",
      "  text-decoration: none;",
      "  font-size: 14px;",
      "}",
      ".link:hover { text-decoration: underline; }",
      "",
      "/* Главная */",
      ".hero {",
      "  background: linear-gradient(135deg, var(--blue-700), var(--blue-900));",
      "  color: #fff;",
      "  padding: 48px 32px;",
      "  border-radius: 12px;",
      "  margin-bottom: 28px;",
      "}",
      ".hero h1 { color: #fff; font-size: 32px; margin-bottom: 12px; }",
      ".hero p { font-size: 16px; opacity: .95; max-width: 600px; }",
      "",
      ".gallery {",
      "  display: grid;",
      "  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));",
      "  gap: 18px;",
      "}",
      ".gallery img {",
      "  width: 100%;",
      "  height: 200px;",
      "  object-fit: cover;",
      "  border-radius: 10px;",
      "  border: 1px solid var(--border);",
      "}",
      "",
      "/* Таблицы */",
      "table {",
      "  width: 100%;",
      "  border-collapse: collapse;",
      "  background: #fff;",
      "}",
      "th, td {",
      "  padding: 10px 12px;",
      "  text-align: left;",
      "  border-bottom: 1px solid var(--border);",
      "  font-size: 14px;",
      "}",
      "th { background: var(--blue-100); color: var(--blue-900); font-weight: 600; }",
      "",
      ".status {",
      "  display: inline-block;",
      "  padding: 3px 10px;",
      "  border-radius: 12px;",
      "  font-size: 12px;",
      "  font-weight: 600;",
      "}",
      ".status.new { background: #fff3cd; color: #856404; }",
      ".status.scheduled { background: #d1ecf1; color: #0c5460; }",
      ".status.done { background: #d4edda; color: #155724; }",
      "",
      "footer {",
      "  text-align: center;",
      "  padding: 16px;",
      "  color: var(--muted);",
      "  font-size: 13px;",
      "  border-top: 1px solid var(--border);",
      "  background: #fff;",
      "}"
    ],
    "description": "Полный styles.css для проекта ConfPortal: сброс, переменные, шапка, формы, кнопки, hero, галерея, таблицы, статусы, футер"
  }


}